APP_NAME="NP Analytics"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_DATABASE=/absolute/path/to/database.sqlite

# Perangkat diaktifkan dari layar Pengaturan Sync (token disimpan terenkripsi).
# Tidak ada API key Gemini di aplikasi mobile; analisis AI diproksikan server.
AI_INSIGHT_PATH=/api/ai/insight
GEMINI_TIMEOUT=30
GEMINI_CONNECT_TIMEOUT=5
SYNC_TIMEOUT=20
SYNC_CONNECT_TIMEOUT=5

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

VITE_APP_NAME="${APP_NAME}"
